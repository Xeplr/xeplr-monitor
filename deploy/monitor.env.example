# /etc/xeplr-monitor/monitor.env — readable by root and xeplr-monitor only (chmod 640).

# Required. Where its users, services and audit log live. Absolute.
MONITOR_DATA_DIR=/var/lib/xeplr-monitor

# Required. Signs the sign-in cookie; at least 32 characters. Make one with:
#   openssl rand -base64 48
MONITOR_SECRET=

# Required. What it may control, comma-separated; * matches anything.
# sudoers must allow the same (sudoers.example).
MONITOR_ALLOW=xeplr-*

# Optional.
# MONITOR_PORT=19400          (default 19400)
# MONITOR_SUDO=actions        (actions | all | none — see the README)

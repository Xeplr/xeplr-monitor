# The monitor behind nginx, on its own name (https only). It listens on
# 127.0.0.1:19400; nginx is the only way in.
server {
  listen 443 ssl http2;
  server_name monitor.example.com;
  # ssl_certificate / ssl_certificate_key: as for the other sites (certbot)

  location / {
    proxy_pass http://127.0.0.1:19400;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # A live log is one long answer: no buffering, and kept open.
    proxy_buffering off;
    proxy_read_timeout 1h;
  }
}

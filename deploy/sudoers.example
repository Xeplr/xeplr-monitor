# /etc/sudoers.d/xeplr-monitor — install with:
#   sudo install -m 440 sudoers.example /etc/sudoers.d/xeplr-monitor && sudo visudo -c
#
# The monitor's user may start, stop, restart and kill the xeplr-* services,
# without a password, and nothing else: not a shell, not another command.
# Keep the pattern the same as MONITOR_ALLOW. Add a line per extra pattern
# (e.g. postgresql) if MONITOR_ALLOW names one.
#
# Note: in sudoers a * also matches spaces, so this line alone would let
# "systemctl stop xeplr-x sshd" through. The monitor never sends that: it
# passes exactly one name, checked against [A-Za-z0-9@._:-] and MONITOR_ALLOW
# first (lib/systemd.js unitName, lib/services.js).
xeplr-monitor ALL=(root) NOPASSWD: /usr/bin/systemctl start xeplr-*, /usr/bin/systemctl stop xeplr-*, /usr/bin/systemctl restart xeplr-*, /usr/bin/systemctl kill --signal=SIGKILL xeplr-*

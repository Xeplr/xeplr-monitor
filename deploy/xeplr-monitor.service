# The monitor itself, as a systemd service. Copy to
# /etc/systemd/system/xeplr-monitor.service, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now xeplr-monitor
#
# It runs as its own user (xeplr-monitor), not root: sudoers (sudoers.example)
# lets that user start/stop/restart/kill the allowed services and nothing
# else; the systemd-journal group lets it read their logs.
[Unit]
Description=Xeplr Monitor (status, control and logs of this server's services)
After=network-online.target

[Service]
Type=simple
User=xeplr-monitor
Group=xeplr-monitor
SupplementaryGroups=systemd-journal
EnvironmentFile=/etc/xeplr-monitor/monitor.env
ExecStart=/usr/bin/env xeplr-monitor-server
Restart=always
RestartSec=3
# sudo needs to gain privileges, so NoNewPrivileges stays off; sudoers is the limit.
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

# xeplr-monitor API — PRODUCTION settings. Copy to production.env on the server
# and fill in; start with NODE_ENV=production (bin/www reads <NODE_ENV>.env).
# production.env is never committed (.gitignore).
#
# Every value that is a secret is blank here. Generate new ones for production
# — never reuse development's.

NODE_ENV=production
LOG_DIR=./logs

# ── Ports: one per process on this server ──
XEPLR_MONITOR_PORT=19402
AUTH_PORT=19401

# ── Databases (same server, one login) ──
ENCRYPTION_KEY=
XEPLR_MONITOR_CONNECTION=
AUTH_DB_CONNECTION_INFO_ENCRYPTED=
DB_API=xeplr_monitor_api
AUTH_DB_NAME=xeplr_monitor_auth
DB_WORKFLOW=xeplr_monitor_workflow

# ── Sign-in ──
REDIS_PREFIX=xeplr-monitor:
AUTH_JWT_SECRET=
# Where THIS server reaches the sign-in service (not the public address).
AUTH_URL=http://127.0.0.1:19401
XEPLR_AUTH_MIGRATIONS=./node_modules/@xeplr/factory/migrations-auth,./node_modules/@xeplr/workflow-api/migrations-auth,./migrations-auth
AUTH_SUPER_ADMIN_EMAIL=
AUTH_SUPER_ADMIN_PASSWORD=
# none for one set of roles; a multi-tenant app names its company header, e.g. x-company-id
AUTH_TENANT_HEADER=none

# ── Public addresses (what people's browsers open) ──
AUTH_ACTIVATION_URL=https://app.example.com/auth/activate
AUTH_INVITE_URL=https://app.example.com/auth/accept-invite

# ── Where this app's files live — an absolute folder that exists ──
# A folder per company inside it: <XEPLR_DATA_DIR>/xeplr-monitor/<company>/…
XEPLR_DATA_DIR=/var/lib/xeplr-monitor/data

# xeplr-monitor API — PRODUCTION settings: every name, no values. The deploy
# (deploy/deploy.js) writes the real file on the server, at
# /opt/xeplr-monitor/shared/production.env, making the secrets there and
# keeping them on later deploys; the services read it (EnvironmentFile).
# Never committed (.gitignore).

NODE_ENV=production
# Absolute: a relative folder depends on where the process started.
LOG_DIR=/var/lib/xeplr-monitor/logs

# ── Ports: one per process on this server ──
XEPLR_MONITOR_PORT=19402
AUTH_PORT=19401

# ── Databases (same server, one login, encrypted with ENCRYPTION_KEY) ──
ENCRYPTION_KEY=
XEPLR_MONITOR_CONNECTION=
AUTH_DB_CONNECTION_INFO_ENCRYPTED=
DB_API=xeplr_monitor_api
AUTH_DB_NAME=xeplr_monitor_auth
# The backup jobs' own database (@xeplr/jobs).
DB_JOBS=xeplr_monitor_jobs
# Where a dump is written before it goes to S3 (absolute; deleted after).
XEPLR_DATA_DIR=/var/lib/xeplr-monitor/data

# ── Redis (sign-in sessions and permissions) ──
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX=xeplr-monitor:

# ── Sign-in ──
AUTH_JWT_SECRET=
# Where THIS server reaches the sign-in service (not the public address).
AUTH_URL=http://127.0.0.1:19401
XEPLR_AUTH_MIGRATIONS=./migrations-auth,./node_modules/@xeplr/jobs/migrations-auth,./node_modules/@xeplr/backups/migrations-auth
AUTH_SUPER_ADMIN_EMAIL=
AUTH_SUPER_ADMIN_PASSWORD=
AUTH_TENANT_HEADER=none
AUTH_REGISTER_ROLES=Viewer

# ── Public addresses (what people's browsers open) ──
AUTH_ACTIVATION_URL=https://monitor.example.com/auth/activate
AUTH_INVITE_URL=https://monitor.example.com/auth/accept-invite
AUTH_RESET_URL=https://monitor.example.com/auth/reset-password

# ── How the monitor controls services ──
# The one command sudoers allows (deploy/control.sh, installed by the deploy).
MONITOR_CONTROL_COMMAND=/usr/local/libexec/xeplr-monitor-control
# MONITOR_SUDO=actions        (actions | all | none — how it asks systemd; see the README)
